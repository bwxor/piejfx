<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="440.0" prefWidth="520.0"
            styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfx.controller.impl.RepositoriesSettingsViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="40.0" prefWidth="475.0">
                <children>
                    <Label alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="475.0"
                           styleClass="window-title" text="Plugin Repositories" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" layoutX="439.0" layoutY="5.0" mnemonicParsing="false"
                            onAction="#onCloseButtonClick" prefHeight="30.0" prefWidth="46.0" styleClass="button-close"
                            text="✕" AnchorPane.rightAnchor="6.0"/>
                    <Button fx:id="minimizeButton" layoutX="404.0" layoutY="5.0" mnemonicParsing="false"
                            onAction="#onMinimizeButtonClick" prefHeight="30.0" prefWidth="46.0"
                            styleClass="button-minimize" text="─" AnchorPane.rightAnchor="58.0"/>
                </children>
            </AnchorPane>
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox alignment="TOP_LEFT" spacing="8.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0"
                      AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="10.0">
                    <Label text="Repository URLs (plugin metadata files)"/>
                    <Label style="-fx-font-size: 11px;" text="Double-click a URL to edit it. Click Save to store the list."
                           wrapText="true"/>

                    <ListView fx:id="repositoriesListView" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="No repositories. Click Add to add one."/>
                        </placeholder>
                    </ListView>

                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <VBox.margin><Insets top="4.0"/></VBox.margin>
                        <Button mnemonicParsing="false" onAction="#onAddButtonClick" text="Add"/>
                        <Button mnemonicParsing="false" onAction="#onRemoveButtonClick" text="Remove"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onAction="#onSaveButtonClick" text="Save"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </children>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
