<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="400.0" prefWidth="420.0"
            styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bwxor.piejfx.controller.impl.PluginInfoViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction"
                        onMousePressed="#handleClickAction" prefHeight="40.0" prefWidth="475.0">
                <children>
                    <Label alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="475.0"
                           styleClass="window-title" text="Plugin Information" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"/>
                    <Button fx:id="closeButton" layoutX="439.0" layoutY="5.0" mnemonicParsing="false"
                            onAction="#onCloseButtonClick" prefHeight="30.0" prefWidth="46.0" styleClass="button-close"
                            text="✕" AnchorPane.rightAnchor="6.0"/>
                    <Button fx:id="minimizeButton" layoutX="404.0" layoutY="5.0" mnemonicParsing="false"
                            onAction="#onMinimizeButtonClick" prefHeight="30.0" prefWidth="46.0"
                            styleClass="button-minimize" text="─" AnchorPane.rightAnchor="58.0"/>
                </children>
            </AnchorPane>
            <AnchorPane styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox alignment="TOP_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                      AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
                      AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" VBox.vgrow="ALWAYS" spacing="6.0">

                    <!-- Name -->
                    <Label fx:id="pluginNameLabel" text="Unknown plugin">
                        <font><Font size="20.0"/></font>
                    </Label>

                    <!-- Author: "by Author Name" -->
                    <Label fx:id="pluginAuthorLabel" text="by Unknown author" style="-fx-font-size: 13px;">
                        <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                    </Label>

                    <!-- Slug: read-only field + Copy button -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <VBox.margin><Insets bottom="4.0"/></VBox.margin>
                        <TextField fx:id="pluginSlugField" editable="false" style="-fx-font-size: 11px;"
                                   HBox.hgrow="ALWAYS"/>
                        <Button mnemonicParsing="false" onMouseClicked="#onCopySlugButtonClick" text="Copy"/>
                    </HBox>

                    <!-- Verified -->
                    <Label fx:id="pluginVerifiedLabel" text="The plugin is not verified">
                        <VBox.margin><Insets bottom="6.0"/></VBox.margin>
                    </Label>

                    <!-- Description (scrollable) -->
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content>
                            <Label fx:id="pluginDescriptionLabel" text="Unknown description" wrapText="true"/>
                        </content>
                    </ScrollPane>

                    <!-- Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <VBox.margin><Insets top="10.0"/></VBox.margin>
                        <Button mnemonicParsing="false"
                                onMouseClicked="#onHomepageButtonClick" text="Access homepage"/>
                    </HBox>
                </VBox>
            </AnchorPane>
        </children>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
