<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" onKeyPressed="#onKeyPressed" prefHeight="500.0" prefWidth="700.0" styleClass="window-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bwxor.piejfx.controller.impl.SearchInFilesViewController">
    <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="app-window" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" VBox.vgrow="ALWAYS">
        <children>
            <AnchorPane fx:id="titleBarAnchorPane" onMouseDragged="#handleMovementAction" onMousePressed="#handleClickAction" prefHeight="35.0" prefWidth="700.0">
                <children>
                    <Label fx:id="windowTitle" alignment="CENTER" layoutY="12.0" prefHeight="17.0" prefWidth="700.0" styleClass="window-title" text="Search in Files" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
                    <Button fx:id="closeButton" mnemonicParsing="false" onAction="#onCloseButtonClick" prefHeight="25.0" prefWidth="40.0" styleClass="button-close" text="✕" AnchorPane.rightAnchor="5.0" AnchorPane.topAnchor="5.0">
                    </Button>
                    <Button fx:id="minimizeButton" mnemonicParsing="false" onAction="#onMinimizeButtonClick" prefHeight="25.0" prefWidth="40.0" styleClass="button-minimize" text="—" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="5.0">
                    </Button>
                </children>
            </AnchorPane>

            <AnchorPane minWidth="-Infinity" styleClass="main-content" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchTextField" 
                                   promptText="Enter search text..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="searchButton" 
                                text="Search"/>
                    </HBox>

                    <TableView fx:id="resultsTableView" 
                               VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="fileNameColumn" 
                                        text="File Name" 
                                        prefWidth="200"/>
                            <TableColumn fx:id="lineColumn" 
                                        text="Line" 
                                        prefWidth="80"/>
                            <TableColumn fx:id="textColumn" 
                                        text="Text" 
                                        prefWidth="400"/>
                        </columns>
                    </TableView>
                </VBox>
            </AnchorPane>
        </children>
        <VBox.margin>
            <Insets />
        </VBox.margin>
    </VBox>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
    </padding>
</AnchorPane>
